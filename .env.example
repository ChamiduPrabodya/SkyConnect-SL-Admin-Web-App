# Copy this file to .env and enter your Firebase Web App config.
# Do not put service-account/private server credentials in this frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend 2 FastAPI base URL, e.g. http://127.0.0.1:8000
VITE_AI_API_BASE_URL=http://127.0.0.1:8000

# Public Web Push certificate key from Firebase Cloud Messaging settings.
VITE_FIREBASE_VAPID_KEY=
